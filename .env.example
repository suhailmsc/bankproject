# Copy to .env for local use (docker compose reads it automatically).
# In AWS, inject these from Secrets Manager / SSM Parameter Store instead of a file.

# --- Core --------------------------------------------------------------------
DEBUG=1                                   # 0 in any shared or production environment
SECRET_KEY=                               # required when DEBUG=0; python -c "import secrets; print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=localhost,127.0.0.1         # comma separated; add your domain / ALB DNS name
CSRF_TRUSTED_ORIGINS=                     # e.g. https://bank.example.com
SITE_URL=http://localhost:8000            # used in verification emails
DATABASE_URL=postgresql://banking:banking_dev_password@db:5432/banking
# DATABASE_URL=sqlite:///db.sqlite3       # quick local run without Docker

# --- Staff console -----------------------------------------------------------
ADMIN_URL=staff-console/                  # change it; customers can never sign in here regardless

# --- HTTPS / proxy (defaults: HTTPS enforced whenever DEBUG=0) ----------------
# HTTPS_ONLY=1
# BEHIND_PROXY=1                          # set behind ALB/nginx so X-Forwarded-Proto/For are trusted
# TRUSTED_PROXY_COUNT=1
# HSTS_SECONDS=31536000

# --- Bank rules ---------------------------------------------------------------
DEMO_MODE=1                               # lets customers add fictional funds; set 0 to disable
REQUIRE_EMAIL_VERIFICATION=0              # defaults to 1 when DEBUG=0
DAILY_LIMIT_KYC_VERIFIED=200000
DAILY_LIMIT_KYC_PENDING=25000
TRANSFER_MAX_PER_TXN=100000
MAX_ACCOUNTS_PER_CUSTOMER=5
BENEFICIARY_COOLING_MINUTES=0             # e.g. 30 to hold new payees for half an hour
SESSION_IDLE_SECONDS=900
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- Optional infra ------------------------------------------------------------
# REDIS_URL=redis://redis:6379/1          # shared cache for rate limits across workers
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Northstar Bank <no-reply@yourdomain.example>
# WEB_CONCURRENCY=3
# RUN_MIGRATIONS=1                        # 0 on web containers if migrations run as a separate job
# LOG_LEVEL=INFO
